# ============================================================================
#  GameVault 环境变量示例
# ============================================================================
#  用法：复制成 .env 再填自己的值。`.env` 已被 .gitignore 挡住，不会被提交。
#
#      cp .env.example .env
#
#  取值优先级（以 scripts/sync.py 为例）：
#      命令行参数  >  环境变量 / .env  >  （无）
#  一个都不给会**直接报错退出**，不会静默退化成某个人的账号。
# ============================================================================


# ---------------------------------------------------------------------------
# Steam —— 自己去申请，别用别人的
# ---------------------------------------------------------------------------
# API Key：https://steamcommunity.com/dev/apikey
#   ⚠️ 申请前提：账号**非受限**（累计消费 $5 以上）且绑了手机令牌。
#   ⚠️ 这把 Key 等于你的身份，谁拿到都能以你的名义调 Steam 接口。
#      只放在本机 .env 里，不要写进任何源码、不要贴进截图。
STEAM_API_KEY=your_32_hex_api_key_here

# SteamID64：17 位数字，【个人资料】页 URL 里那串，或 https://steamid.io 查。
#   桌面版/同步脚本能自动从本机 Steam 客户端读出来，可以留空。
STEAM_ID=7656119xxxxxxxxxx


# ---------------------------------------------------------------------------
# 服务端（server/app.py）
# ---------------------------------------------------------------------------
# 监听端口。不填默认 3000。
PORT=3000

# 对外的公开地址，用于拼 OpenID 回调地址（形如 https://your-domain.example）。
#   不填时退回用请求头推断 —— 本地开发留空即可。
PUBLIC_BASE=

# 桌面版开关：桌面启动器会设成 1。
#   🔴 置真时 server/app.py 才会注册 /api/local/* 路由（读本机 Steam 文件）。
#      云端部署**永远不要设它** —— 那些路由会 404，本机 Steam 路径、账号、
#      游戏库都属于个人数据，不能有任何机会从公网访问。
# GV_DESKTOP=0
